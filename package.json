{
	"name": "mindmap-view",
	"version": "0.0.1",
	"description": "XMind-like mind mapping view for Obsidian markdown files.",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"fixtures": "node scripts/generate-fixtures.mjs",
		"bench:m1": "node scripts/bench-m1.mjs",
		"bench:m2": "node scripts/bench-m2.mjs",
		"bench:images": "node scripts/bench-images.mjs",
		"bench:relations": "node scripts/bench-relations.mjs",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@types/node": "^20.11.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.28.1",
		"jsdom": "^29.1.1",
		"obsidian": "^1.4.11",
		"typescript": "^5.3.3",
		"vitest": "^3.2.5"
	},
	"dependencies": {
		"d3-flextree": "^2.1.2"
	}
}
